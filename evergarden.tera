---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor: ["fall", "winter", "spring", "summer"]
  filename: "evergarden-{{ flavor }}.el"
---
{% set red = flavor.colors.red %}
{% set orange = flavor.colors.orange %}
{% set yellow = flavor.colors.yellow %}
{% set lime = flavor.colors.lime %}
{% set green = flavor.colors.green %}
{% set aqua = flavor.colors.aqua %}
{% set skye = flavor.colors.skye %}
{% set snow = flavor.colors.snow %}
{% set blue = flavor.colors.blue %}
{% set purple = flavor.colors.purple %}
{% set pink = flavor.colors.pink %}
{% set cherry = flavor.colors.cherry %}
{% set text = flavor.colors.text %}
{% set subtext1 = flavor.colors.subtext1 %}
{% set subtext0 = flavor.colors.subtext0 %}
{% set overlay2 = flavor.colors.overlay2 %}
{% set overlay1 = flavor.colors.overlay1 %}
{% set overlay0 = flavor.colors.overlay0 %}
{% set surface2 = flavor.colors.surface2 %}
{% set surface1 = flavor.colors.surface1 %}
{% set surface0 = flavor.colors.surface0 %}
{% set base = flavor.colors.base %}
{% set mantle = flavor.colors.mantle %}
{% set crust = flavor.colors.crust %}

;;; evergarden-theme.el --- Cozy evergarden dark theme -*- lexical-binding: t; -*-

;; Author: expansion of the original evergarden theme by @koi.rip
;; Version: 0.1.0
;; Package-Requires: ((emacs "28.1") (modus-themes "5.0.0") (ef-themes "2.0.0"))
;; Keywords: faces, theme

;;; Commentary:
;; The evergarden theme (https://evergarden.moe), ported to Emacs and based on ef/modus themes

;;; Code:

(require 'modus-themes)
(require 'ef-themes)

(defgroup evergarden-theme nil
  "Cozy evergarden dark theme built on Modus and Ef."
  :group 'faces
  :group 'ef-themes
  :prefix "evergarden-")

(defconst evergarden-theme-description
  "Cozy evergarden dark theme with forest-green accents."
  "Documentation string for the `evergarden' theme.")

(defconst evergarden-theme-name 'evergarden
  "Theme symbol for `evergarden'.")

(defconst evergarden-theme-family 'evergarden-theme
  "Theme family symbol for `evergarden'.")

(defconst evergarden-theme-background-mode 'dark
  "Background mode for `evergarden'.")

(defconst evergarden-palette-partial
