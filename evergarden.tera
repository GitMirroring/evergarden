    (fg-term-cyan cyan)
    (bg-term-cyan-bright cyan-warmer)
    (fg-term-cyan-bright cyan-warmer)
    (bg-term-white fg-dim)
    (fg-term-white fg-dim)
    (bg-term-white-bright fg-main)
    (fg-term-white-bright fg-main)
    (rainbow-0 green)
    (rainbow-1 cyan)
    (rainbow-2 magenta)
    (rainbow-3 blue)
    (rainbow-4 orange)
    (rainbow-5 red)
    (rainbow-6 yellow)
    (rainbow-7 fg-alt)
    (rainbow-8 fg-dim)
    (fg-heading-0 green)
    (fg-heading-1 green)
    (fg-heading-2 cyan)
    (fg-heading-3 magenta)
    (fg-heading-4 blue)
    (fg-heading-5 orange)
    (fg-heading-6 red)
    (fg-heading-7 fg-alt)
    (fg-heading-8 fg-dim)
    (bg-heading-0 unspecified)
    (bg-heading-1 bg-green-nuanced)
    (bg-heading-2 unspecified)
    (bg-heading-3 bg-magenta-nuanced)
    (bg-heading-4 bg-blue-nuanced)
    (bg-heading-5 unspecified)
    (bg-heading-6 bg-red-nuanced)
    (bg-heading-7 unspecified)
    (bg-heading-8 unspecified)
    (overline-heading-0 green)
    (overline-heading-1 green)
    (overline-heading-2 cyan)
    (overline-heading-3 magenta)
    (overline-heading-4 blue)
    (overline-heading-5 orange)
    (overline-heading-6 red)
    (overline-heading-7 unspecified)
    (overline-heading-8 unspecified))
  "Semantic color mappings for `evergarden'.")

(defcustom evergarden-palette-overrides nil
  "Overrides for `evergarden-palette'.

Each element should have the form (NAME VALUE), where NAME is a palette
entry from `evergarden-palette' and VALUE is either another palette symbol
or a color string."
  :group 'evergarden-theme
  :package-version '(evergarden-theme . "0.1.0")
  :type '(repeat (list symbol (choice symbol string))))

(defconst evergarden-palette
  (modus-themes-generate-palette
   evergarden-palette-partial
   'cool
   nil
   (append evergarden-palette-mappings-partial ef-themes-palette-common))
  "Full palette for `evergarden'.")

(defconst evergarden-custom-faces
  '(`(corfu-default ((,c :inherit modus-themes-fixed-pitch
                      :background ,bg-dim
                      :foreground ,fg-main)))
    `(corfu-current ((,c :background ,bg-green-intense
                      :foreground ,fg-main
                      :extend t
                      :box (:line-width -1 :color ,green)
                      :weight semi-bold)))
    `(corfu-border ((,c :background ,border
                     :foreground ,border)))
    `(corfu-bar ((,c :background ,green)))
    `(corfu-popupinfo ((,c :background ,bg-dim
                        :foreground ,fg-main))))
  "Additional face overrides for `evergarden'.

Prefer palette entries and semantic mappings first.
Use direct face overrides only for targeted package cases where the
inherited mapping does not provide enough contrast.")

(defun evergarden--ensure-modus-theme-metadata ()
  "Declare `evergarden' as a Modus-derived theme when reloading in-session.

If an `evergarden' theme object already exists in the session, ensure it
still has the theme properties that `modus-themes-theme' expects."
  (unless (plist-get (get evergarden-theme-name 'theme-properties) :modus-core-palette)
    (modus-themes-declare
     evergarden-theme-name
     evergarden-theme-family
     evergarden-theme-description
     evergarden-theme-background-mode
     'evergarden-palette
     nil
     'evergarden-palette-overrides)
    (modus-themes-register evergarden-theme-name)))

(evergarden--ensure-modus-theme-metadata)

(modus-themes-theme
 evergarden-theme-name
 evergarden-theme-family
 evergarden-theme-description
 evergarden-theme-background-mode
 'evergarden-palette
 nil
 'evergarden-palette-overrides
 'evergarden-custom-faces)

;;;###autoload
(when load-file-name
  (add-to-list 'custom-theme-load-path
               (file-name-as-directory
                (file-name-directory load-file-name))))

(provide 'evergarden-theme)

;;; evergarden-theme.el ends here
