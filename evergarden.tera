(defconst evergarden-palette-mappings-partial
  '(
    (err red)
    (warning orange)
    (info cyan)
    (underline-err red)
    (underline-warning orange)
    (underline-note cyan)
    (modeline-err red)
    (modeline-warning yellow)
    (modeline-info cyan)
    (bg-prominent-warning bg-warning)
    (fg-prominent-warning fg-main)
    (bg-prominent-note bg-info)
    (fg-prominent-note fg-main)
    (fg-link blue)
    (fg-link-visited magenta)
    (fg-link-symbolic cyan)
    (bg-link unspecified)
    (bg-link-symbolic unspecified)
    (bg-link-visited unspecified)
    (underline-link blue)
    (underline-link-visited magenta)
    (underline-link-symbolic cyan)
    (name cyan)
    (keybind green)
    (identifier fg-main)
    (fg-prompt green)
    (bg-prompt unspecified)
    (builtin cyan-cooler)
    (comment fg-dim)
    (constant magenta-cooler)
    (fnname cyan)
    (fnname-call cyan-warmer)
    (keyword red)
    (preprocessor green)
    (property fg-main)
    (docstring fg-dim)
    (docmarkup green-cooler)
    (string green-warmer)
    (type yellow)
    (variable blue)
    (variable-use blue)
    (rx-backslash orange)
    (rx-construct magenta)
    (accent-0 green)
    (accent-1 cyan)
    (accent-2 magenta-warmer)
    (accent-3 orange)
    (fg-button-active fg-main)
    (fg-button-inactive fg-dim)
    (bg-button-active bg-main)
    (bg-button-inactive bg-dim)
    (fg-region fg-main)
    (bg-mark-delete bg-red-subtle)
    (fg-mark-delete red)
    (bg-mark-select bg-green-subtle)
    (fg-mark-select green)
    (bg-mark-other bg-cyan-subtle)
    (fg-mark-other cyan)
