    (bg-main "{{ base.hex }}")
    (bg-dim "{{ surface0.hex }}")
    (bg-alt "{{ surface1.hex }}")
    (fg-main "{{ text.hex }}")
    (fg-dim "{{ subtext1.hex }}")
    (fg-alt "{{ subtext0.hex }}")
    (bg-active "{{ surface2.hex }}")
    (bg-inactive "{{ surface0.hex }}")
    (border "{{ overlay0.hex }}")

    (bg-hl "{{ surface2.hex }}")
    (bg-prose-block "#2A3237")
    (red "{{ red.hex }}")
    (orange "{{ orange.hex }}")
    (yellow "{{ yellow.hex }}")
    (lime "{{ lime.hex }}")
    (green "{{ green.hex }}")
    (aqua "{{ aqua.hex }}")
