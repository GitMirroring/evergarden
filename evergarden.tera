    (bg-search-rx-group-3 bg-red-intense)
    (bg-space-err bg-red-intense)
    (bg-space bg-main)
    (fg-space border)
    (fringe bg-main)
    (fg-line-number-active green)
    (fg-line-number-inactive overlay1)
    (bg-line-number-active bg-hl-line)
    (bg-line-number-inactive bg-main)
    (bg-tab-bar bg-dim)
