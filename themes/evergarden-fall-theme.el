;;; evergarden-fall-theme.el --- Evergarden, Fall flavor -*- lexical-binding: t; -*-

;; Author: expansion of the original evergarden theme by @koi.rip
;; Version: 0.2.0
;; Package-Requires: ((emacs "28.1") (modus-themes "5.0.0") (ef-themes "2.0.0"))
;; Keywords: faces, theme

;;; Commentary:
;;
;; The Fall flavor of evergarden -- generated by whiskers from
;; the shared color table, same as lua/evergarden/palettes/fall.lua.
;; All the actual face wiring lives in evergarden-common.el; this file only
;; supplies Fall's own colors. DO NOT EDIT BY HAND -- edit the
;; .tera template and re-run whiskers instead.

;;; Code:

;; Not `(file-name-directory (or load-file-name buffer-file-name))' --
;; both can be nil depending on how the loader gets here (byte-compile
;; caches, `eval-buffer', some straight.el paths), which signals
;; `(wrong-type-argument stringp nil)'. `custom-theme-load-path' is
;; reliably populated by the time any theme file loads (it's how this
;; file was found in the first place), so search that instead.
(unless (featurep 'evergarden-common)
  (let ((common (locate-file "evergarden-common"
                              (append (seq-filter #'stringp custom-theme-load-path)
                                      load-path)
                              '(".el" ".elc" ""))))
    (if common
        (load common)
      (error "evergarden-common.el not found; add its directory to `custom-theme-load-path'"))))

